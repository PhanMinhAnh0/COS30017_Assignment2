<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_marginTop="40dp" >

        <ImageButton
            android:id="@+id/ibRBack"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center_vertical|start"
            android:src="@drawable/icon_back"
            android:backgroundTint="@color/white"
            android:layout_marginStart="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rent"
            android:layout_gravity="center"
            android:textSize="30sp"
            android:textStyle="bold" />

    </FrameLayout>

    <ImageView
        android:id="@+id/imgRCar"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_margin="20dp"
        android:scaleType="centerCrop"
        android:contentDescription="CarImage"/>

    <TextView
        android:id="@+id/tvRCTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="30sp"
        android:textStyle="bold" />
    
    <SeekBar
        android:id="@+id/sbDuration"
        style="@style/Widget.AppCompat.SeekBar.Discrete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:max="6"
        android:progress="0"
        android:layout_marginTop="40dp"/>

    <TextView
        android:id="@+id/tvRDuration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Duration: 1 Day"
        android:gravity="center"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/tvRCost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:textSize="20sp"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"/>

    <EditText
        android:id="@+id/etRReceive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:hint="Receiver Name (Required)"
        android:inputType="textPersonName|textCapWords"
        android:imeOptions="actionDone"/>

    <Button
        android:id="@+id/btnRent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:text="Rent Now"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:backgroundTint="@color/blue"
        android:layout_marginTop="10dp"/>

</LinearLayout>